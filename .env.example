# LLM (default provider: DeepSeek)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub
GITHUB_TOKEN=
# The account "my repositories" and user:@me mean. Leave empty to use the owner of the token.
# GITHUB_USERNAME=
# GITHUB_API_URL=https://api.github.com

# Google (Gmail). Token file = authorized-user JSON with a refresh token (scopes: gmail.readonly,
# gmail.compose). Credentials file (OAuth client) is only read if the token file lacks client_id/secret.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# Web search (web.search is only offered when at least one listed provider has a key; web.open /
# web.extract need no key). WEB_SEARCH_PROVIDERS sets the order: the first is tried first, the next
# takes over on failure or no result. Default: brave,tavily. Providers: brave, tavily.
WEB_SEARCH_PROVIDERS=tavily,brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# User-Agent sent by web.open / web.extract. Some sites (Wikipedia) answer 403 to clients that
# give no way to contact their operator: use "name/version (https://your-site; you@example.org)".
# WEB_USER_AGENT=

# LinkedIn (scopes: openid, profile, w_member_social). Versions are retired ~1 year after release.
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_VERSION=202607

# Code executor sandbox (code.* tools, agent code-executor). Unset = the tools are not offered.
# Only mechanism: subprocess (hardened child process, no network, limits below). Needs Linux and
# `unshare`; when network isolation is not permitted the tools are reported as skipped.
# OPENCLAW_CODE_SANDBOX=subprocess
# Files of each agent live in <workdir>/<agent-id> (default: <workspace>/sandbox).
# OPENCLAW_CODE_WORKDIR=
# OPENCLAW_CODE_TIMEOUT=10
# OPENCLAW_CODE_CPU_SECONDS=10
# OPENCLAW_CODE_MEMORY_MB=256
# OPENCLAW_CODE_MAX_OUTPUT_BYTES=64000
# Windows / no `unshare`: set to true to run anyway WITHOUT network isolation (and without CPU and
# memory limits). Executed code can then read your files and use the network: local use only,
# read every script before approving it. Ignored where isolation is available.
# OPENCLAW_CODE_ALLOW_UNISOLATED=true

# Documents (docs.* tools, agent writer): Markdown and LaTeX documents, LaTeX -> PDF. No credential
# needed. Files live under this directory (default: <workspace>/shared/reports); give each LaTeX
# document its own subdirectory: compilation only reads and writes inside the .tex file's directory.
# OPENCLAW_DOCS_DIR=
# docs.compile_pdf is only offered when the engine is installed and `unshare --net` is permitted
# (reported as skipped otherwise). Engines: xelatex (default), pdflatex, lualatex.
# OPENCLAW_DOCS_LATEX_ENGINE=xelatex
# Windows / no `unshare`: set to true to compile anyway WITHOUT network isolation (ADR-027).
# TeX still runs with shell escape disabled and its restricted file mode (reads and writes only in
# the .tex file's directory), under a time limit, with a scrubbed environment (no API key), but the
# engine can use the network (MiKTeX may download missing packages). Local use only; every
# compilation still needs your approval. Ignored where isolation is available.
# The engine (xelatex from MiKTeX or TeX Live) must be on your PATH; install the packages of the
# allowlist beforehand (MiKTeX: install missing packages "Always", never "Ask me first").
# OPENCLAW_DOCS_ALLOW_UNISOLATED=true
# Wall-clock limit of one compilation, in seconds (default 60).
# OPENCLAW_DOCS_LATEX_TIMEOUT=60
# Comma-separated LaTeX packages a document may declare (document classes: article, report).
# OPENCLAW_DOCS_LATEX_PACKAGES=fontspec,geometry,hyperref,amsmath,graphicx,booktabs,listings

# Telegram channel (`openclaw telegram`, long polling). The bot can send e-mails and run code, so
# the list of authorized users is mandatory: numeric Telegram ids separated by commas (ask @userinfobot).
# Only private chats with these users are served; everyone else is ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Team whose supervisor answers free text (default: OPENCLAW_TEAM). /run <agent> <task> bypasses it.
# TELEGRAM_TEAM=default
# Seconds to answer an approval request before it counts as a rejection (default 300).
# TELEGRAM_APPROVAL_TIMEOUT=300
# Bot API base URL (default https://api.telegram.org).
# TELEGRAM_API_URL=

# Runtime
# OPENCLAW_HOME holds agents/ and skills/ (default: the current directory); the workspace is
# relative to it. OPENCLAW_MAX_STEPS caps the ReAct loop of one run (default 25).
# OPENCLAW_HOME=.
OPENCLAW_WORKSPACE=workspace
# OPENCLAW_MAX_STEPS=25
# Team the supervisor delegates within (teams/<id>/team.yaml). Default: default.
# `openclaw team run <team> "<task>"` overrides it for that run.
# OPENCLAW_TEAM=default
# Every execution is traced under executions/ (execution.json, events.jsonl, result.md). The
# trace keeps tool inputs and outputs, e-mail contents included. off = no trace.
# OPENCLAW_TRACE=on
OPENCLAW_LOG_LEVEL=INFO

# web
OPENCLAW_WEB_HOST=127.0.0.1
OPENCLAW_WEB_PORT=8000